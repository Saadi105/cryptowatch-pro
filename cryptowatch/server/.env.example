# Copy this file and rename it to .env
# Then fill in your actual values

# Your MongoDB connection string
# Get it free at: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://yourUsername:yourPassword@cluster0.xxxxx.mongodb.net/cryptowatch

# The port your server will run on
PORT=5000

# CoinGecko API key (optional - free tier works without it)
# Get one at: https://coingecko.com/api
COINGECKO_API_KEY=
